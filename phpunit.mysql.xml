<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Isolated MySQL Integration">
            <file>tests/Feature/M2MySqlRuntimePersistenceTest.php</file>
            <file>tests/Feature/AlumniWorkFieldMySqlTest.php</file>
            <file>tests/Feature/QuizMultimediaMySqlIntegrationTest.php</file>
            <file>tests/Feature/QuizMultimediaMySqlConcurrencyTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="CACHE_STORE" value="file" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="wms_mysql_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="WMS_RUNTIME_DB_CONNECTION" value="mysql" force="true"/>
        <env name="WMS_RUNTIME_DB_DATABASE" value="wms_mysql_test" force="true"/>
        <env name="WMS_MYSQL_INTEGRATION" value="1" force="true"/>
        <env name="WMS_ALLOW_TEST_TRUNCATE" value="false" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
